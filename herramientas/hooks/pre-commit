#!/bin/sh
# full-autodev: las compuertas 'block' bloquean el commit.
GATES="$HOME/.claude/skills/full-autodev/references/gates.py"
[ -f "$GATES" ] || exit 0
python "$GATES" --root . || {
  echo ""
  echo "commit bloqueado por una compuerta. Para saltarla a conciencia: git commit --no-verify"
  exit 1
}
